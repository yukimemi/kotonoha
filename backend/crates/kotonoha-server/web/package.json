{
  "name": "kotonoha-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "_comment": "`bun run vite` on Windows swallows vite's stdout (bun bug). Calling node + vite.js directly bypasses bun's script-shim layer entirely.",
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "tsc -b && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.4",
    "@pixiv/three-vrm-animation": "^3.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}

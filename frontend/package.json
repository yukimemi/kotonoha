{
  "name": "kotonoha-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "_comment": "`bun run vite` on Windows swallows vite's stdout (bun bug). Calling node + vite.js directly bypasses bun's script-shim layer entirely.",
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "tsc -b && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.2",
    "@pixiv/three-vrm-animation": "^3.5.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.0",
    "vite": "^8.0.13",
    "vite-plugin-pwa": "^1.3.0"
  }
}
